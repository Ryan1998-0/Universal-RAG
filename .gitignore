__pycache__/
*.py[cod]
.DS_Store

.env
.env.*
!.env.production.example
.venv/
venv/

.pytest_cache/
.mypy_cache/
.local/
tmp/
logs/
*.log

# IFRS Foundation source PDFs and extracted text are intentionally not tracked.
profiles/ifrs17/source_pdfs/*.pdf
profiles/ifrs17/raw/*.txt
profiles/ifrs17/index/*
!profiles/ifrs17/index/.gitkeep

# Labor law embeddings are generated locally from the tracked official text.
profiles/labor_standards_act/index/*
!profiles/labor_standards_act/index/.gitkeep

# Retrieval runs may include copyrighted content previews from local documents.
evals/ifrs17_retrieval/runs/
evals/graph_suitability/runs/
evals/self_rag_timing/runs/
evals/document_folders/runtime-state.json
evals/document_folders/setup-results.json
evals/production_release_gate/runs/
evals/prompt_injection/runs/

*.npy

# Full MultiHop-RAG retrieval runs keep resumable checkpoints and smoke files
# locally; only the completed compact report/results are versioned.
evals/multihop_rag_retrieval_full/checkpoints/
evals/multihop_rag_retrieval_full/smoke*/
