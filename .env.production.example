APP_DOMAIN=rag.example.com
ACME_EMAIL=admin@example.com
RAG_SERVICE_VERSION=0.2.0

POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-long-random-secret
QDRANT_API_KEY=replace-with-a-long-random-secret
S3_ACCESS_KEY_ID=replace-with-a-random-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-long-random-secret

RAG_OIDC_ISSUER=https://identity.example.com/
RAG_OIDC_AUDIENCE=universal-rag-api
RAG_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
RAG_OIDC_AUTHORIZATION_URL=https://identity.example.com/oauth2/authorize
RAG_OIDC_TOKEN_URL=https://identity.example.com/oauth2/token
RAG_OIDC_CLIENT_ID=universal-rag-web
RAG_OIDC_CLIENT_SECRET=replace-with-the-oidc-client-secret
RAG_OIDC_SCOPES=openid profile email
RAG_OIDC_TENANT_CLAIM=tenant_id
RAG_OIDC_ROLES_CLAIM=roles
RAG_CORS_ORIGINS=https://rag.example.com
RAG_WEB_SESSION_TTL_SECONDS=28800
RAG_WEB_LOGIN_STATE_TTL_SECONDS=600

# One-time explicit identity provisioning. Values must match the OIDC token claims.
RAG_PROVISION_TENANT_ID=replace-with-tenant-id-claim
RAG_PROVISION_TENANT_NAME=Example RAG Workspace
RAG_PROVISION_SUBJECT=replace-with-oidc-sub-claim
RAG_PROVISION_DISPLAY_NAME=Example User
RAG_PROVISION_ROLE=owner
RAG_PROVISION_KNOWLEDGE_BASE_NAME=主要知識庫
RAG_PROVISION_PROFILE=default
RAG_PROVISION_VISIBILITY=private

RAG_MODEL=ollama:qwen2.5:7b
RAG_ALLOWED_MODELS=ollama:qwen2.5:7b
RAG_OLLAMA_URL=https://inference.internal.example.com
RAG_MAX_CONCURRENT_GENERATIONS=5
RAG_REQUEST_TIMEOUT_SECONDS=180
RAG_GENERATION_QUEUE_TIMEOUT_SECONDS=30
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DIMENSIONS=384
RAG_SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_MAX_UPLOAD_BYTES=52428800
RAG_UPLOAD_SESSION_TTL_SECONDS=900
RAG_UPLOAD_MODE=proxy
RAG_PARSER_VERSION=canonical-v1
RAG_CHUNK_SCHEMA_VERSION=parent-child-v1
RAG_INDEX_BATCH_SIZE=64
RAG_OCR_LANGUAGES=chi_tra+eng
RAG_INGESTION_LEASE_SECONDS=600
RAG_INGESTION_HEARTBEAT_INTERVAL_SECONDS=60
RAG_CLAMAV_HOST=clamav
RAG_CLAMAV_PORT=3310
RAG_PROMPT_INJECTION_POLICY=quarantine
RAG_BACKGROUND_HEARTBEAT_TTL_SECONDS=90
RAG_WORKER_CONCURRENCY=2
